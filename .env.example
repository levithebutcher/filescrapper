# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Target website base URL
BASE_URL=https://dropmms.com

# Comma-separated streaming domains to extract (Optional)
# STREAMING_DOMAINS=vidara.to,streamtape.com,streamfiles.net,lplaygo.com,doodstream.com,streamwish,filelions,dropload,mixdrop,streamruby,cloudfam.io

# Max posts to extract per forum page
MAX_POSTS_PER_FORUM=15

# Delay between sending posts to prevent flood wait (seconds)
POST_SEND_DELAY=1.5

# HTTP request timeout (seconds)
REQUEST_TIMEOUT=15

# Max length of post title
MAX_TITLE_LENGTH=120

# Optional Proxy settings (if target website is blocked)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# Optional Bot Owner Telegram ID
# OWNER_ID=123456789
